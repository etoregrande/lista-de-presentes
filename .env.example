NODE_ENV="development"

DATABASE_URL="postgresql://presenteio:presenteio_dev@127.0.0.1:5434/presenteio_dev"
APP_ENV=local
SEED_DEMO_DATA=true
MAIL_TRANSPORT=mailpit
MAILPIT_API_URL="http://127.0.0.1:8025"
MAILPIT_UI_URL="http://127.0.0.1:8025"
# Staging only: match MP_SEND_API_AUTH configured on the Mailpit service.
# MAILPIT_SEND_USER=
# MAILPIT_SEND_PASSWORD=

BUCKET_DOMAIN=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_KEY=
BUCKET_SECRET_KEY=

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=

EMAIL_VERIFICATION_CALLBACK_URL="/wishlist"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=

NEXT_PUBLIC_SOCIAL_LOGIN_ENABLED=false

# Product import: Amazon/generic HTML works without external credentials.
# Mercado Livre OAuth: login to Presenteio with this admin email, then open
# /api/integrations/mercadolivre/connect after deploying the callback.
MERCADOLIVRE_CLIENT_ID=4028819120323937
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://presenteio.app/api/integrations/mercadolivre/callback
MERCADOLIVRE_ADMIN_EMAIL=
# Generate once (openssl rand -hex 32). Keep stable: encrypts stored tokens.
MERCADOLIVRE_TOKEN_SECRET=
